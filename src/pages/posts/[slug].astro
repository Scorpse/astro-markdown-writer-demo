---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import Page from "../../layouts/Page.astro";
import { formatDate, publishedPosts, sitePath } from "../../lib/posts";

export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, cover } = post.data;
---
<Page title={title} description={description}>
  <article class="article">
    <a class="back" href={sitePath("archive/")}>← Archive</a>
    <header class="article-header">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    {cover && <Image src={cover.image} alt={cover.alt} class="cover" />}
    <div class="prose"><Content /></div>
    {tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map((tag) => <li>{tag}</li>)}</ul>}
  </article>
</Page>
